#!/bin/sh
# Portable (POSIX sh) full local gate. No pass-result caching (by design; add only after measured need).
# Artifact caches (sccache, cargo/npm caches) are fine. CI on the integrated change stays authoritative.
# Exit 0 only if every applicable step passed. Missing tool = BLOCKED = failure (never silently skipped).
# Usage: check [--only rust|web|go|all]   (default all). Lane checks match the lane (C6, founder 2026-10-03): a lane runs
# `--only <kind>` with <kind> from `owned-paths --kind TASK.md`; integrated CI runs check without --only (everything).
# The secret scans and the agent-definitions step always run. The Rust steps run under the machine build lock with the
# repo's shared CARGO_TARGET_DIR (C5, bin/build-lock.sh); a lock held elsewhere after BUILD_LOCK_WAIT is BLOCKED rust.
# A Go module (go.mod) runs make gen, the committed-output check, make lint and make test, without the build lock
# (exchange D-158: Go's memory is small and its cache is per-user).
# A failed step prints the last VERIFY_FAIL_TAIL lines of its output (default 15; local-gate exports 400; anything but
# a positive integer is refused, exit 2), then its failing: block (step(), below); both print the output redacted.
set -u
usage() { echo "check: usage: check [--only rust|web|go|all]" >&2; exit 2; }
only=all
if [ $# -gt 0 ]; then
  [ $# -eq 2 ] && [ "$1" = "--only" ] || usage
  case "$2" in rust|web|go|all) only=$2;; *) usage;; esac
fi
fail_tail=${VERIFY_FAIL_TAIL:-15}
case "$fail_tail" in 0*|*[!0-9]*) fail_tail=;; esac
if [ -z "$fail_tail" ] || ! tail -n "$fail_tail" < /dev/null > /dev/null 2>&1; then
  echo "check: VERIFY_FAIL_TAIL must be a positive integer, got '${VERIFY_FAIL_TAIL-}'" >&2; exit 2
fi
export NO_COLOR=1 FORCE_COLOR=0 CI=1
# User-local toolchains (rustup, cargo-installed tools, gitleaks, gh) without touching the caller's shell profile.
PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"; export PATH
# sqlx-cli connects even with zero queries, so DATABASE_URL must be set; read the repo's git-ignored .env when it isn't.
# .env is DATA, never code (retro review 1): only DATABASE_URL is taken from it, literally, by bin/read-env.
if [ -z "${DATABASE_URL:-}" ] && [ -r .env ]; then
  v=$(sh "$(dirname "$0")/read-env" DATABASE_URL .env) && { DATABASE_URL=$v; export DATABASE_URL; }
fi
fail=0
# Redaction (exchange E10 plan read R1-10), one sed over a failed step's output before the tail or failing: reads it:
# "://<user>:<password>@" becomes "://***@" (the userinfo of a URL's authority, to its last @, as Go's url.Parse
# splits it) and "password=<non-space>" in any case becomes "<key>=***" (so PGPASSWORD= too). Nothing else changes.
# Bytes, not characters (LC_ALL=C), so an invalid UTF-8 byte cannot stop a match early.
redact() { LC_ALL=C sed -e 's|://[^/?#@:[:space:]]*:[^/?#[:space:]]*@|://***@|g' \
  -e 's|\([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\)=[^[:space:]][^[:space:]]*|\1=***|g'; }
# failing: (exchange BACKLOG 122, D-471; R1-09): `go test ./...` prints packages in import-path order, so a failing
# cmd/, internal/api or internal/db never reached the tail. Every line of the whole output that names a failure, in
# first-seen order, each once, blank lines never, indented, after a "failing:" line; at most 80, then "failing: <n>
# lines (capped at 80)" when <n> > 80 matched; nothing at all when none did. Kept (ERE):
#   ^[[:space:]]*--- FAIL          a Go test or subtest
#   ^[[:space:]]*FAIL[[:space:]]   a package: Go's FAIL<tab><pkg>, nextest's "FAIL [", vitest's " FAIL " (not Go's bare
#                                  FAIL line, not FAILED)
#   ^panic:                        a panic; a TestMain or init panic is attributed by its package's FAIL line
#   seed[=:]                       a replay seed, anywhere in the line
#   \[(build|setup) failed\]       the line itself, and before the last such line the compiler diagnostics ^# (the
#                                  package header) or \.go:[0-9]+:[0-9]+: , at most 20
#   ^WARNING: DATA RACE            and the next 6 lines
#   ^[[:space:]]*running tests:    right after a ^panic: test timed out line, then the indented test names after it,
#                                  10 lines in all
failing_block() { LC_ALL=C awk '
  { l[NR] = $0 } /\[(build|setup) failed\]/ { bf = NR }
  END {
    for (i = 1; i <= NR; i++) { s = l[i]; k = 0
      if (race > 0) { k = 1; race-- }
      if (names > 0) { if (s ~ /^[[:space:]]+[^[:space:]]/) { k = 1; names-- } else names = 0 }
      if (tmo) { tmo = 0; if (s ~ /^[[:space:]]*running tests:/) { k = 1; names = 9 } }
      if (s ~ /^[[:space:]]*--- FAIL/ || s ~ /^[[:space:]]*FAIL[[:space:]]/ || s ~ /^panic:/ || s ~ /seed[=:]/ ||
          s ~ /\[(build|setup) failed\]/) k = 1
      if (s ~ /^WARNING: DATA RACE/) { k = 1; race = 6 }
      if (s ~ /^panic: test timed out/) tmo = 1
      if (i < bf && nd < 20 && (s ~ /^# / || s ~ /\.go:[0-9]+:[0-9]+: /) && !(s in seen)) { k = 1; nd++ }
      if (!k || s ~ /^[[:space:]]*$/ || (s in seen)) continue
      seen[s] = 1; if (++n <= 80) o[n] = s
    }
    if (n == 0) exit 0
    print "failing:"; for (i = 1; i <= n && i <= 80; i++) print "      " o[i]
    if (n > 80) print "failing: " n " lines (capped at 80)"
  }'; }
step() { name=$1; shift; out=$("$@" 2>&1); rc=$?
  if [ $rc -eq 0 ]; then echo "PASS  $name"; return 0; fi
  echo "FAIL  $name"; fail=1
  out=$(printf '%s\n' "$out" | redact) || out="(the output is withheld: its redaction failed)"
  printf '%s\n' "$out" | tail -n "$fail_tail" | sed 's/^/      /'
  printf '%s\n' "$out" | failing_block; }
need() { command -v "$1" >/dev/null 2>&1 || { echo "BLOCKED $2 (missing tool: $1)"; fail=1; return 1; }; }

if [ "$only" = web ] || [ "$only" = go ]; then echo "SKIP  rust (--only $only)"
elif [ -f Cargo.toml ]; then
  if need cargo "rust"; then
    BUILD_LOCK_WHO=check; . "$(dirname "$0")/build-lock.sh"
    build_lock_acquire; brc=$?
    if [ $brc -eq 3 ]; then
      echo "BLOCKED rust (build lock held by $BUILD_LOCK_HOLDER_WHO, pid $BUILD_LOCK_HOLDER_PID, since $BUILD_LOCK_HOLDER_SINCE)"; fail=1
    elif [ $brc -ne 0 ]; then echo "BLOCKED rust (build lock not acquired, see above)"; fail=1
    elif ! build_lock_env; then echo "BLOCKED rust (shared target not prepared, see above)"; fail=1; build_lock_release
    else
      step "rust fmt"     cargo fmt --all -- --check
      step "rust clippy"  cargo clippy --workspace --all-targets --message-format short -- -D warnings
      if need cargo-nextest "rust tests"; then step "rust tests" cargo nextest run --workspace --failure-output final --status-level fail; fi
      if need sqlx "sqlx offline check"; then step "sqlx check" cargo sqlx prepare --workspace --check; fi
      if need cargo-deny "deny"; then step "deps/licences (cargo deny)" cargo deny check; fi
      if need cargo-audit "audit"; then step "rust advisories (cargo audit)" cargo audit; fi
      build_lock_release
    fi
  fi
else echo "SKIP  rust (no Cargo.toml)"; fi

if [ "$only" = rust ] || [ "$only" = go ]; then echo "SKIP  frontend (--only $only)"
elif [ -f web/package.json ]; then
  if need npm "frontend"; then
    # Always a clean install from the lockfile: a pre-existing node_modules is never trusted (retro review 8).
    step "npm ci"          sh -c 'cd web && npm ci --no-audit --no-fund'
    step "web typecheck"   sh -c 'cd web && npx --no-install tsc --noEmit'
    step "web lint/format" sh -c 'cd web && npx --no-install biome ci .'
    step "web unit tests"  sh -c 'cd web && npx --no-install vitest run'
    step "npm audit"       sh -c 'cd web && npm audit --audit-level=high'
    step "bundle budget"   sh -c 'cd web && npm run --silent budget'
  fi
else echo "SKIP  frontend (no web/package.json)"; fi

# Go (exchange D-158): no build lock. `make gen` must leave the working tree as it found it: a snapshot taken right
# before it (tracked changes, then every untracked file under an `untracked <path>` header, which also carries the
# untracked list, plus `git status --porcelain`) is compared with one taken after, so a lane's own uncommitted work
# counts only where gen changed it. Every producer's exit status is checked: a failed snapshot is a FAIL, never a pass.
# The diff ignores the product's diff config (--no-ext-diff --no-textconv), so a driver cannot mask a change. Gitignored
# generated files are outside the check. The Makefile's gen, lint and test targets must be .PHONY: a file or directory
# of the same name makes make skip the recipe.
go_git() { git -c core.quotePath=false "$@"; }
go_snap() { # go_snap <file>
  go_git diff HEAD --binary --no-ext-diff --no-textconv --no-renames > "$1" &&
    go_git ls-files -z --others --exclude-standard > "$1.z" &&
    xargs -0 sh -c 'for f do printf "untracked %s\n" "$f"; cat -- "$f" || exit 1; done' sh < "$1.z" >> "$1" &&
    go_git status --porcelain > "$1.st"
}
go_committed() {
  d=$go_snap_dir
  if [ "$go_snap_rc" -ne 0 ] || ! go_snap "$d/after"; then
    [ -z "$d" ] || cat "$d/before.err" 2>/dev/null; echo "could not snapshot the working tree"; return 1
  fi
  cmp -s "$d/before" "$d/after" && cmp -s "$d/before.st" "$d/after.st" && return 0
  diff "$d/before.st" "$d/after.st" | grep '^[<>]' > "$d/st.diff"
  # The changed paths, sorted and unique: status lines that differ, plus every chunk (one per `diff --git` or
  # `untracked` header) whose bytes differ, which names a path whose status line is unchanged. They come first and
  # the whole message stays within step's 15-line tail.
  { sed 's/^[<>] ...//' "$d/st.diff"
    awk 'FNR == 1 { k = "" } FILENAME == ARGV[1] { s = "a" } FILENAME == ARGV[2] { s = "b" }
      /^diff --git / || /^untracked / { k = $0 } { c[s, k] = c[s, k] $0 "\n"; seen[k] = 1 }
      END { for (k in seen) if (k != "" && c["a", k] != c["b", k]) {
        if (k ~ /^untracked /) print substr(k, 11)
        else { p = substr(k, 12); print substr(p, 3, (length(p) - 5) / 2) } } }' "$d/before" "$d/after"
  } | sort -u > "$d/paths"
  n=$(wc -l < "$d/paths")
  echo "make gen changed the working tree; commit the generated code:"
  [ "$n" -gt 0 ] || { echo "changed: (no path named; the snapshots differ)"; n=1; }
  awk 'NR <= 10 { print "changed: " $0 } END { if (NR > 10) print "… and " NR - 10 " more" }' "$d/paths"
  [ "$n" -gt 10 ] && n=11
  sed 's/^</before:/; s/^>/after: /' "$d/st.diff" | head -n $((13 - n))
  return 1
}
if [ "$only" = rust ] || [ "$only" = web ]; then echo "SKIP  go (--only $only)"
elif [ -f go.mod ]; then
  go_ok=1; need go "go" || go_ok=0; need make "go" || go_ok=0
  if [ $go_ok -eq 1 ] && [ ! -f Makefile ]; then echo "BLOCKED go (no Makefile with gen, lint and test targets)"; fail=1
  elif [ $go_ok -eq 1 ]; then
    go_snap_rc=1; go_snap_dir=$(mktemp -d) && { go_snap "$go_snap_dir/before" 2> "$go_snap_dir/before.err"; go_snap_rc=$?; }
    step "go generate (make gen)" make gen
    step "generated code committed (make gen changed nothing)" go_committed
    step "go lint (make lint)" make lint
    step "go tests (make test)" make test
    [ -z "$go_snap_dir" ] || rm -rf "$go_snap_dir"
  fi
else echo "SKIP  go (no go.mod)"; fi

if [ -d .claude/agents ] && [ -d standards/agents ]; then
  step "agent definitions match pinned standards" diff -r standards/agents .claude/agents
fi

# Uncommitted + untracked content is collected into a file first and every producer's exit status is checked, so a
# failed collection can never pass as "no secrets"; `--` keeps a file named like an option (--version) from being
# read as one and swallowing the other files (retro review 15).
scan_uncommitted() {
  f=$(mktemp) || return 1
  if git diff HEAD > "$f" && git ls-files -z --others --exclude-standard > "$f.list" && xargs -0 cat -- /dev/null < "$f.list" >> "$f"; then
    gitleaks stdin --no-banner --redact < "$f"; rc=$?
  else echo "could not collect the uncommitted and untracked content"; rc=1; fi
  rm -f "$f" "$f.list"; return $rc
}
if need gitleaks "secret scan"; then
  step "secret scan (committed history)" gitleaks detect --no-banner --redact
  step "secret scan (uncommitted + untracked)" scan_uncommitted
fi

[ $fail -eq 0 ] && echo "check: OK" || echo "check: FAILED"
exit $fail
