#!/bin/sh
# Usage: standards/bin/dispatch-deepseek <ABS_WORKTREE> [effort: max|high]
# Runs a lane headless (LOW by default; HIGH only under DISPATCH_ALLOW_HIGH=1, D-073): Claude Code harness, DeepSeek model. Env vars follow DeepSeek's official guide
# (api-docs.deepseek.com/quick_start/agent_integrations/claude_code); effort defaults to max, as the guide does
# (founder 2026-10-06; high until v0.1.17); pass `high` explicitly for a lighter lane.
# Web tools disabled: lanes need none, and DeepSeek web search adds token cost and injection surface.
# DeepSeek settings exist ONLY in this process. HIGH lanes are refused unless DISPATCH_ALLOW_HIGH is exactly 1
# (founder decision D-073, 2026-10-02: an Opus-written TASK/contract, Opus review mandatory). Absolute refusals, with
# or without that variable: repos marked .no-deepseek, and a TASK whose §3 owns an admin surface (m1.1 O2).
# Refusals before dispatch exit 2. After the run the lane is judged on bytes and by judges it could not touch: it must
# have added commits on its branch, left a clean tree (git errors and hidden index edits fail closed), changed nothing
# under scripts/verify/, standards or .gitmodules, and then pass `check` and the instrument section named in TASK §5,
# both read BEFORE the run (the instrument script is taken from the pre-run commit). Otherwise exit 1 naming the
# reason (retro review 14 and its fix round).
# C7 (founder 2026-10-03): this script's own copy of task-lint runs right after the Risk check (header, branch, base,
# the owned-paths block, sections, clean tree, submodule pointer, 15 GB free disk); ownership — and with it the admin
# refusal (NOTES-19 defect 2) — is read from the TASK's owned-paths block only (bin/owned-paths). C6: the post-run check
# is `check --only <kind>` (owned-paths --kind). C5: the post-run judgement (check + instrument) runs under the machine
# build lock this script acquires; BUILD_LOCK_TOKEN reaches the judges only, never claude; the lock is not held while
# claude runs.
# Standards docs lanes (docs/07 §1, DeepSeek scope 3): the standards repository, known by its root commit (never by a
# file a lane could add or delete), has no `check` and no instrument. There every path TASK §3 owns, and after the run
# every changed path, must be a literal path in the docs allow-list (docs/ except docs/05*, the prose templates
# templates/*.md, CHANGELOG.md, README.md; no agent-instruction file, no dot segment), and every committed file mode
# 100644, so the judges and the policy (bin/, tests/, smoke/, .github/, agents/, prompts/, specs/, every non-prose
# template a product repo copies, CLAUDE.md/AGENTS*.md, .claude/.codex) are out of reach. TASK §5 names the judges as
# `sh tests/<name>.t.sh`; after the run each of them and the markdown judge `tests/docs.t.sh --judge` (on every
# docs/**/*.md and README.md) run from a tree built from the PRE-run commit, with only the allow-listed paths taken
# from the lane's commit. No build lock (nothing is built); logs go to the worktree's git dir.
# Every repo: a dispatcher that lies inside the lane worktree (the lane's own copy) is refused; run the primary's.
set -eu
here=$(cd "$(dirname "$0")" && pwd -P)
wt=${1:?absolute worktree path}; effort=${2:-max}
case "$effort" in max|high) ;; *) echo "dispatch-deepseek: effort must be max or high, not '$effort'" >&2; exit 2;; esac
[ -n "${DS_API_KEY:-}" ] || { echo "dispatch-deepseek: DS_API_KEY not set" >&2; exit 2; }
top=$(git -C "$wt" rev-parse --show-toplevel)
# The judges must not be the lane's own bytes: a copy of this script inside the lane worktree could have been edited
# by an earlier run of that lane (or ship the lane's task-lint and owned-paths).
top_p=$(cd "$top" && pwd -P) || { echo "dispatch-deepseek: refused — cannot resolve $top" >&2; exit 2; }
case "$here/" in "$top_p"/*)
  echo "dispatch-deepseek: refused — this dispatcher lies inside the lane worktree ($here); run the primary checkout's copy" >&2; exit 2;; esac
# The primary checkout (a lane worktree shares its object store and inherits its workspace trust).
root=$(cd "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P)
# .no-deepseek is judged on the PRIMARY checkout's committed tree (and the lane's), not only on the lane's files:
# deleting or replacing the marker inside a lane changes nothing (retro review 12).
if [ -e "$top/.no-deepseek" ] || git -C "$root" cat-file -e HEAD:.no-deepseek 2>/dev/null || git -C "$wt" cat-file -e HEAD:.no-deepseek 2>/dev/null; then
  echo "dispatch-deepseek: refused — this repo never sends code to DeepSeek" >&2; exit 2; fi
# Risk comes from the TASK header only: lines 1-3 hold exactly one `Risk: ` line, it reads `Risk: LOW` (or exactly
# `Risk: HIGH` with DISPATCH_ALLOW_HIGH=1, D-073), and no other line of the TASK starts with `Risk: ` (a `Risk: LOW`
# further down a HIGH TASK never counts; retro review 12).
task=$wt/TASK.md
[ -f "$task" ] || { echo "dispatch-deepseek: refused — no TASK.md in $wt" >&2; exit 2; }
in_header=$(head -n 3 "$task" | grep -c '^Risk: ' || true); in_task=$(grep -c '^Risk: ' "$task" || true)
risk=$(head -n 3 "$task" | sed -n 's/^Risk: //p'); high=0
if [ "$in_header" != 1 ] || [ "$in_task" != 1 ]; then risk=""; fi
case "$risk" in
  LOW) ;;
  HIGH) if [ "${DISPATCH_ALLOW_HIGH:-}" = 1 ]; then high=1; else risk=""; fi;;
  *) risk="";;
esac
[ -n "$risk" ] || { echo "dispatch-deepseek: refused — TASK is not Risk: LOW (the header, lines 1-3, must hold the only Risk: line; Risk: HIGH needs DISPATCH_ALLOW_HIGH=1, founder decision D-073)" >&2; exit 2; }
# C7: task-lint before every dispatch — this script's own copy, never the lane's. A TASK without a valid owned-paths
# block (HIGH or LOW) is refused here, so the admin check below always has an ownership to judge.
sh "$here/task-lint" "$wt" >&2 || { echo "dispatch-deepseek: refused — task-lint failed (see above)" >&2; exit 2; }
# Admin screens resolve, void and reissue questions: never sent to DeepSeek, whatever the Risk line or the override
# (m1.1 O2). Judged on the owned-paths block of TASK §3 only (NOTES-19 defect 2: a "never touch" line is not
# ownership): any path with an `admin` segment or an admin.<ext> file, case-insensitive.
own=$(sh "$here/owned-paths" "$task") || { echo "dispatch-deepseek: refused — the owned-paths block of TASK §3 is unreadable" >&2; exit 2; }
if printf '%s\n' "$own" | grep -Eqi -e '/admin([^A-Za-z0-9_-]|$)' -e '(^|[^A-Za-z0-9_-])admin(/|\.[A-Za-z0-9])'; then
  echo "dispatch-deepseek: refused — admin surface in TASK §3 cannot go to DeepSeek even with DISPATCH_ALLOW_HIGH" >&2; exit 2; fi
# The standards repository: its root commit is in the lane's history (capture first: a git error is a refusal).
STD_ROOT=4e78d67036ddafaa07c9dac9bb74249c4dd2e895
STD_ALLOW="literal paths in docs/ except docs/05*, templates/NAME.md (prose, one segment), CHANGELOG.md, README.md; no CLAUDE.md, CLAUDE.local.md, AGENTS*.md or dot segment"
roots=$(git -C "$wt" rev-list --max-parents=0 HEAD) || { echo "dispatch-deepseek: refused — cannot read the root commits of $wt" >&2; exit 2; }
std=0; if printf '%s\n' "$roots" | grep -qx "$STD_ROOT"; then std=1; fi
std_allowed() { # std_allowed <path or owned pattern>: 0 only for a literal path inside the docs allow-list.
  # Literal only: a `*` (an owned glob, or a literal `*` in a changed name) is refused, since it also matches `/`, dot
  # files and agent-instruction files. Every segment must be non-empty, not start with `.` (`.`, `..`, .claude, .codex,
  # .gitattributes) and not be an agent-instruction file (CLAUDE.md, CLAUDE.local.md, AGENTS*.md: instructions are not
  # "non-sensitive prose"). The regions match exactly (docs/, templates/, CHANGELOG.md, README.md: `Docs/x.md` is
  # refused); the exceptions inside them are compared case-insensitively (a case-insensitive checkout maps docs/05… onto
  # DOCS/05…): docs/05* is refused, and templates/ admits only one segment ending in .md (any case).
  case "$1" in *"*"*) return 1;; esac
  sa_low=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  sa_rest=$sa_low/
  while [ -n "$sa_rest" ]; do
    sa_seg=${sa_rest%%/*}; sa_rest=${sa_rest#*/}
    case "$sa_seg" in ''|.*|claude.md|claude.local.md|agents*.md) return 1;; esac
  done
  case "$1" in
    docs/*) case "${sa_low#docs/}" in 05*) return 1;; esac; return 0;;
    templates/*) case "${sa_low#templates/}" in */*) return 1;; ?*.md) return 0;; *) return 1;; esac;;
    CHANGELOG.md|README.md) return 0;;
    *) return 1;;
  esac; }
if [ "$std" = 1 ]; then
  bad_own=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    std_allowed "$p" || bad_own="$bad_own${bad_own:+ }$p"
  done <<EOF
$own
EOF
  [ -z "$bad_own" ] || { echo "dispatch-deepseek: refused — TASK §3 owns $bad_own, outside the standards docs allow-list ($STD_ALLOW)" >&2; exit 2; }
fi
# C6: the lane is judged by the checks that match it.
kind=$(sh "$here/owned-paths" --kind "$task") || { echo "dispatch-deepseek: refused — the owned-paths block of TASK §3 is unreadable" >&2; exit 2; }
branch=$(sed -n 's/^Branch: //p' "$task")
[ "$(git -C "$wt" branch --show-current)" = "$branch" ] || { echo "dispatch-deepseek: branch mismatch" >&2; exit 2; }
# Headless `claude -p` never shows the trust dialog and ignores a project's permission allow rules until the
# REPOSITORY ROOT (the primary checkout — a lane worktree inherits it) was trusted once interactively. Fail fast with
# the remedy instead of running a lane whose every tool call is auto-denied and whose untouched worktree would then
# pass `check` (m1.1 O3). Read-only look at Claude's state; closed when the look is impossible.
command -v jq >/dev/null 2>&1 || { echo "dispatch-deepseek: refused — jq is required for the workspace trust check" >&2; exit 2; }
[ -r "$HOME/.claude.json" ] || { echo "dispatch-deepseek: refused — $HOME/.claude.json is unreadable, so $root is not a trusted Claude Code workspace here; run \`claude\` once inside it and accept the dialog" >&2; exit 2; }
jq -e --arg p "$root" '.projects[$p].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1 \
  || { echo "dispatch-deepseek: refused — $root is not a trusted Claude Code workspace; run \`claude\` once inside it and accept the dialog" >&2; exit 2; }
# The lane's instrument section, read from TASK §5 BEFORE the run: the lane cannot rewrite what it is judged by.
# In the standards repository: the judges `sh tests/<name>.t.sh` it names, each present at HEAD, plus tests/docs.t.sh.
if [ "$std" = 1 ]; then
  sjudges=$(awk '/^## /{ s = ($0 ~ /^## 5\./) } s' "$task" | { grep -oE 'sh tests/[A-Za-z0-9_-][A-Za-z0-9_.-]*\.t\.sh' || true; } | sed 's/^sh //' | awk '!seen[$0]++')
  [ -n "$sjudges" ] || { echo "dispatch-deepseek: refused — TASK §5 names no judge (sh tests/<name>.t.sh); the standards repository has no instrument" >&2; exit 2; }
  head0=$(git -C "$wt" rev-parse HEAD) || { echo "dispatch-deepseek: refused — git rev-parse HEAD failed in $wt" >&2; exit 2; }
  for j in $sjudges tests/docs.t.sh; do
    git -C "$wt" cat-file -e "$head0:$j" 2>/dev/null || { echo "dispatch-deepseek: refused — TASK §5 judge $j does not exist at $head0" >&2; exit 2; }
  done
  jlist=""; for j in $sjudges; do jlist="${jlist}sh $j, "; done
else
inst=$(awk '/^## /{ s = ($0 ~ /^## 5\./) } s' "$task" | sed -n 's/.*\(scripts\/verify\/m[0-9_]*\.sh\) --section \([a-z0-9_-][a-z0-9_-]*\).*/\1 \2/p' | head -n 1)
[ -n "$inst" ] || { echo "dispatch-deepseek: refused — TASK §5 names no instrument section (scripts/verify/mN.sh --section <name>, N a number)" >&2; exit 2; }
script=${inst% *}; section=${inst#* }
fi
# Retro review 13: nothing of the caller's environment reaches claude, check or the instrument except this allowlist
# (SHELL included: Claude Code's Bash tool needs a shell). Secrets exported in the caller's shell stay there.
allow="HOME PATH USER LANG LC_ALL TERM TMPDIR XDG_CONFIG_HOME SHELL"
base_env() { # base_env <NAME=value ...> <cmd ...>: run with an empty environment plus the allowlisted variables that are set
  for v in $allow; do if eval "[ -n \"\${$v+x}\" ]"; then eval "set -- \"$v=\${$v}\" \"\$@\""; fi; done
  env -i "$@"; }
ds_env() { base_env \
  ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic" \
  ANTHROPIC_AUTH_TOKEN="$DS_API_KEY" \
  ANTHROPIC_MODEL="deepseek-flash[1m]" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-flash[1m]" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-flash[1m]" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-flash" \
  CLAUDE_CODE_SUBAGENT_MODEL="deepseek-flash" \
  CLAUDE_CODE_EFFORT_LEVEL="$effort" \
  CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432 \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  "$@"; }
# A HIGH lane says under which decision it goes, only once nothing can stop it any more (after the brief is read).
d073() { [ "$high" = 0 ] || echo "dispatch-deepseek: HIGH lane sent to DeepSeek under founder decision D-073 (Opus contract + Opus review mandatory)" >&2; }
# Smoke hook: every refusal above has run; stop before anything leaves the machine. Lists the NAMES of the variables
# claude would receive (the real environment of the real wrapper, never the values).
if [ "${DISPATCH_DRY_RUN:-0}" = 1 ]; then
  d073
  echo "dispatch-deepseek: environment passed to claude (names only): $(ds_env env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort | tr '\n' ' ')"
  if [ "$std" = 1 ]; then
    echo "dispatch-deepseek: standards docs lane (root ${STD_ROOT%"${STD_ROOT#???????}"}): every changed path must lie in $STD_ALLOW"
    echo "dispatch-deepseek: judges after the run (from the pre-run commit): ${jlist}sh tests/docs.t.sh --judge <every docs/**/*.md and README.md>"
  else
  echo "dispatch-deepseek: instrument after the run: $script --section $section"
  echo "dispatch-deepseek: checks after the run: check --only $kind, $script --section $section"
  fi
  echo "dispatch-deepseek: checks passed (dry run, nothing dispatched)"; exit 0
fi
if [ "$std" = 1 ]; then
  # The standards repository is its own pinned copy: the brief comes from the lane's tree (prompts/ is outside the
  # allow-list, and task-lint has seen the tree clean), with what differs from a product lane said once.
  brief=$(sed "s|<ABS_WORKTREE>|$wt|g" "$wt/prompts/dispatch-brief.md")
  brief="$brief
This worktree is the standards repository itself: there is no standards/ copy, no standards/bin/check and no instrument. Change only $STD_ALLOW. Your judges are the tests TASK §5 names (run each as \`sh tests/<name>.t.sh\`) and \`sh tests/docs.t.sh --judge $wt <every docs/**/*.md and README.md>\` (relative links resolve, no template placeholders). Every file you commit keeps mode 100644 (no symlinks, no executables)."
  gd=$(git -C "$wt" rev-parse --absolute-git-dir) || { echo "dispatch-deepseek: refused — git rev-parse --absolute-git-dir failed in $wt" >&2; exit 2; }
  runlog=$gd/lane-run.log; checklog=$gd/lane-check.log
else
  brief=$(sed "s|<ABS_WORKTREE>|$wt|g" "$wt/standards/prompts/dispatch-brief.md")
  runlog=.lane-run.log; checklog=.lane-check.log
fi
d073
cd "$wt"
before=$(git rev-parse HEAD)
rc=0
ds_env claude -p "$brief" --permission-mode acceptEdits --disallowedTools WebSearch WebFetch < /dev/null > "$runlog" 2>&1 || rc=$?
tail -n 20 "$runlog"   # final report only; never read full transcripts
# Verify on bytes, not on the report:
fail() { echo "dispatch-deepseek: $1" >&2; exit 1; }
[ "$rc" -eq 0 ] || fail "claude failed (rc=$rc)"
after=$(git rev-parse HEAD)
{ [ "$after" != "$before" ] && git merge-base --is-ancestor "$before" "$after" && [ "$(git branch --show-current)" = "$branch" ]; } \
  || fail "no commit (HEAD $after on $(git branch --show-current), expected new commits on $branch after $before)"
# Admin screens never come from DeepSeek, whatever TASK §3 says: §3 may own a parent directory or a glob, so the
# committed diff is judged with the classifier's rule (both sides of a rename; unquoted names), case-insensitive.
# First of the post-run judgements: an admin commit is named as such, whatever else is wrong with the run.
both=$(git -c core.quotePath=false diff --no-renames --name-only "$before" "$after") || fail "no commit (git diff $before $after failed)"
admin=$(printf '%s\n' "$both" | grep -Ei '(^|/)admin(/|\.)' || true)
[ -z "$admin" ] || { printf '%s\n' "$admin" | head -n 10 >&2; fail "lane changed an admin surface"; }
# TASK.md is the coordinator's untracked brief; anything else left uncommitted means the lane did not finish.
# Capture first, then filter: a failing git status must never read as a clean tree.
st=$(git status --porcelain --untracked-files=all --ignore-submodules=none) || fail "dirty tree (git status failed)"
dirty=$(printf '%s\n' "$st" | grep -vx -e '?? TASK.md' -e '' || true)
[ -z "$dirty" ] || { printf '%s\n' "$dirty" | head -n 10 >&2; fail "dirty tree"; }
tags=$(git ls-files -v) || fail "dirty tree (git ls-files failed)"
if printf '%s\n' "$tags" | grep -v -e '^H ' -e '^$' | grep -q .; then fail "dirty tree (hidden edits: skip-worktree or assume-unchanged entries)"; fi
repl=$(git for-each-ref refs/replace) || fail "dirty tree (git for-each-ref failed)"
[ -z "$repl" ] || fail "dirty tree (hidden edits: refs/replace present)"
if [ "$std" = 1 ]; then
  # Every changed path, both sides of a rename, in the docs allow-list: the judges and the policy stay out of reach.
  # A name git had to quote starts with `"` and is outside the list (fail closed).
  outside=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    std_allowed "$p" || outside="$outside$p
"
  done <<EOF
$both
EOF
  [ -z "$outside" ] || { printf '%s' "$outside" | head -n 10 >&2; fail "lane changed a path outside the standards docs allow-list ($STD_ALLOW)"; }
  # Prose is a regular non-executable file: both sides of every change are 000000 (absent) or 100644; a symlink
  # (120000), a gitlink (160000) or an executable (100755) is refused, printed as `<mode> <path>`.
  raw=$(git -c core.quotePath=false diff --raw --no-renames "$before" "$after") || fail "dirty tree (git diff --raw $before $after failed)"
  modes=$(printf '%s\n' "$raw" | awk -F '\t' 'NF >= 2 { split($1, m, " "); s = substr(m[1], 2); d = m[2]
      if (s != "000000" && s != "100644") print s " " $2; else if (d != "000000" && d != "100644") print d " " $2 }') \
    || fail "dirty tree (reading the file modes failed)"
  [ -z "$modes" ] || { printf '%s\n' "$modes" | head -n 10 >&2; fail "lane committed a file mode other than 100644 (symlink, gitlink or executable)"; }
  # The judge tree: the PRE-run commit (bin/, tests/, smoke/ and the rest), with only the allow-listed paths taken from
  # the lane's commit, so the named tests see the new prose and run the old judges.
  judge_dir=$(mktemp -d) || fail "judge tree (mktemp failed)"; trap 'rm -rf "$judge_dir"' EXIT
  jt=$judge_dir/tree; mkdir "$jt" || fail "judge tree (mkdir failed)"
  { git archive --format=tar -o "$judge_dir/pre.tar" "$before" && tar -xf "$judge_dir/pre.tar" -C "$jt"; } || fail "judge tree (git archive $before failed)"
  rm -rf "$jt/docs" "$jt/templates" "$jt/CHANGELOG.md" "$jt/README.md"
  ov=""; for p in docs templates CHANGELOG.md README.md; do if git cat-file -e "$after:$p" 2>/dev/null; then ov="$ov $p"; fi; done
  if [ -n "$ov" ]; then
    # shellcheck disable=SC2086 # $ov holds fixed names without spaces
    { git archive --format=tar -o "$judge_dir/post.tar" "$after" -- $ov && tar -xf "$judge_dir/post.tar" -C "$jt"; } || fail "judge tree (git archive $after failed)"
  fi
  : > "$checklog" || fail "cannot write $checklog"
  for j in $sjudges; do
    base_env sh "$jt/$j" >> "$checklog" 2>&1 || { tail -n 10 "$checklog" >&2; fail "judge failed ($j from $before; see $checklog)"; }
  done
  # Every markdown doc of the lane's tree, not only the changed ones: a deleted or renamed doc that another doc links to
  # fails here. A name git had to quote is passed as is and fails the judge as "no such file" (fail closed).
  sdocs=$(git -c core.quotePath=false ls-tree -r --name-only "$after" -- docs README.md) || fail "docs judge failed (git ls-tree $after failed)"
  sdocs=$(printf '%s\n' "$sdocs" | grep -Ei -e '^docs/.*\.md$' -e '^README\.md$' || true)
  set --
  while IFS= read -r p; do if [ -n "$p" ]; then set -- "$@" "$p"; fi; done <<EOF
$sdocs
EOF
  base_env sh "$jt/tests/docs.t.sh" --judge "$jt" "$@" >> "$checklog" 2>&1 \
    || { grep -E '^docs: (FAIL|FAILED)' "$checklog" | head -n 20 >&2 || true; fail "docs judge failed (tests/docs.t.sh --judge from $before; see $checklog)"; }
  jdone=""; for j in $sjudges; do jdone="$jdone$j and "; done
  echo "dispatch-deepseek: OK — new commit $after, clean tree, every changed path in the docs allow-list, ${jdone}tests/docs.t.sh --judge green"
  exit 0
fi
# The lane may not touch what judges it: the instruments, the pinned standards (check, verify-lib) or the submodule map.
touched=$(git diff --name-only "$before" "$after") || fail "no commit (git diff $before $after failed)"
judges=$(printf '%s\n' "$touched" | grep -E -e '^scripts/verify/' -e '^standards(/|$)' -e '^\.gitmodules$' || true)
judges=$judges$(printf '%s\n' "$touched" | grep -Fx -e "$script" || true)
[ -z "$judges" ] || { printf '%s\n' "$judges" | head -n 10 >&2; fail "lane changed its own judge"; }
# C5: the judgement (check + instrument) holds the machine build lock; the judges re-enter it through BUILD_LOCK_TOKEN,
# which only they receive (judge_env), never claude.
BUILD_LOCK_WHO=dispatch-deepseek; . "$here/build-lock.sh"
blrc=0; build_lock_acquire || blrc=$?
if [ "$blrc" -ne 0 ]; then [ "$blrc" -ne 3 ] || build_lock_refusal; fail "build lock not acquired (see above)"; fi
judge_env() { base_env BUILD_LOCK_TOKEN="$BUILD_LOCK_TOKEN" "$@"; }
judge_env sh standards/bin/check --only "$kind" > .lane-check.log 2>&1 \
  || { grep -E '^(FAIL|BLOCKED)' .lane-check.log >&2 || true; fail "check failed (see .lane-check.log)"; }
echo "check: OK"
# The instrument as it was BEFORE the run: its whole directory from the pre-run commit (so a chained m(N-1).sh found
# via $(dirname "$0") is the pre-run one too); the scripts cd to the worktree top level themselves.
judge_dir=$(mktemp -d); trap 'rm -rf "$judge_dir"; build_lock_release' EXIT
git archive --format=tar -o "$judge_dir/judge.tar" "$before" "$(dirname "$script")" && tar -xf "$judge_dir/judge.tar" -C "$judge_dir" \
  && [ -f "$judge_dir/$script" ] || fail "instrument section failed ($script does not exist at $before)"
judge_env bash "$judge_dir/$script" --section "$section" >> .lane-check.log 2>&1 \
  || { tail -n 10 .lane-check.log >&2; fail "instrument section failed ($script --section $section; see .lane-check.log)"; }
echo "dispatch-deepseek: OK — new commit $after, clean tree, check green, $script --section $section green"
