#!/bin/sh
# Usage: review-checkout <repo_path> <base_sha> <head_sha> <task_id>   -> prints the checkout path
# Disposable clone for a reviewer: no remotes, no credentials, diff precomputed in .review/diff.patch.
# Reviewer agents get Read/Grep/Glob only (no Bash, no Edit/Write) and use this dir as working dir.
# Tamper evidence for review-verify-clean is recorded OUTSIDE the checkout, as sibling files (retro review 7):
# <dst>.head (the commit checked out) and <dst>.review.sha256 (manifest of .review/*).
# The directory comes from mktemp -d, never from rm -rf on a predictable path (retro review 16).
set -eu
src=${1:?repo path}; base=${2:?base sha}; head=${3:?head sha}; id=${4:?task id}
case "$id" in *[!A-Za-z0-9_.-]*) echo "review-checkout: invalid id '$id' (allowed: A-Z a-z 0-9 _ . -)" >&2; exit 2;; esac
dst=$(mktemp -d "${TMPDIR:-/tmp}/review-$id.XXXXXX")
git clone -q --no-local "$src" "$dst"; cd "$dst"
git checkout -q "$head"; git remote remove origin
# Reviewers need the pinned standards too: initialise the submodule from the source checkout's copy (no network).
git -c protocol.file.allow=always -c "submodule.standards.url=$src/standards" submodule update -q --init 2>/dev/null || echo "review-checkout: standards submodule not initialised (reviewer sees no standards/)" >&2
mkdir -p .review; git diff "$base" "$head" > .review/diff.patch
git diff --name-status "$base" "$head" > .review/files.txt
git rev-parse HEAD > "$dst.head"
sha256sum .review/diff.patch .review/files.txt > "$dst.review.sha256"
echo "$dst"
