#!/bin/sh
# Usage: standards/bin/local-mutants <clone> <base> <crate> [--tests <name>[,<name>...]] [--resume <out-dir>]     (integrator; exchange D-110)
# The local mutation run that replaces the Actions `mutants` workflow (dormant): `cargo mutants --in-diff` over
# `git diff <base> HEAD -- <crate>/src` with `-p <crate> --test-tool nextest --jobs 1 --minimum-test-timeout 60
# --timeout-multiplier 2`, the replay proptest
# excluded from every test run (`-- -E 'not test(=random_sessions_match_model)'`, as the dormant workflow does), and
# each --tests name passed on as `--test <name>` after `--`, so a mutant runs only those test binaries (without --tests,
# the crate's whole suite). Both cargo mutants calls, the --list and the run, carry --no-config, as the dormant
# workflow does: a .cargo/mutants.toml in the tree never changes the selection or the test command. <base> is a full
# 40-character lowercase hex SHA (a ref like HEAD~1 or a branch name can move), named on stderr as "base: <sha>".
# The two options come in either order, each at most once.
# Every cargo mutants call executes inside `systemd-run --user --scope --quiet -p MemoryMax=${MUTANTS_MEMORY_MAX:-3G}
# -p MemorySwapMax=0 -p OOMPolicy=stop --` (--quiet: nothing but the command's output on stdout; OOMPolicy=stop: a
# mutant that meets the cap stops the whole run, which then fails, instead of counting as caught), so a runaway mutant
# meets the cap instead of the machine's OOM killer (8 GB shared; OOM x4 on 2026-10-03). The scope is probed first and
# never skipped: the probe reads memory.max of its own cgroup (`sh -c 'cat /sys/fs/cgroup$(cut -d: -f3
# /proc/self/cgroup)/memory.max'`), which must equal MUTANTS_MEMORY_MAX in bytes (K, M, G x 1024^n; a user manager
# without the memory controller creates the scope and ignores the cap). cargo mutants runs its own baseline (no
# --baseline=skip) in a copy of the tree (--in-place conflicts with --jobs) under the machine build lock
# Timeout (exchange D-155): no fixed --timeout, which cargo mutants applies to the baseline's test run as well; a test
# set whose clean run needs more than 60 s (E4's 31 binaries: about 2 min on blih-runner) then fails as "a red baseline"
# with every test passing. The baseline runs uncapped and each mutant's tests get twice its measured time, at least 60 s
# (a non-terminating mutant ends as a timeout, never caught; OOMPolicy=stop below still bounds its memory)
# (bin/build-lock.sh), with RUSTC_WRAPPER=sccache: every run is cached unless MUTANTS_NO_SCCACHE=1 opts out. Residual: an sccache server already running outside the scope compiles outside the
# cap; the tests, where runaways happen, always run inside it.
# Only in a disposable clone (bin/mutants' rules: its own .git directory, no remote, clean tree, no other worktree),
# never a lane worktree or the primary checkout. Files in scope: every <crate>/src/**/*.rs the diff adds, modifies or
# renames (deletions excluded), with or without mutants, sorted. Outcomes are counted apart from
# mutants.out/{caught,missed,unviable,timeout}.txt; tested is their sum and must equal `cargo mutants --list` for the
# same selection (a listing of 0 skips the run). Exactly one line goes to stdout and to <clone>/mutants-run.txt (C4
# format, BACKLOG 40; unviable and timeout are never caught); everything else goes to stderr:
#   run: <sha> files: <f1> <f2> ... tested: <t> missed: <m> caught: <c> unviable: <u> timeout: <k>
# The names are space-separated, as the exchange's mutants ledger prints them and its instrument splits them.
# Outcome directory: a fresh `mktemp -d` named on stderr ("outcomes in <dir>"), holding changes.diff, list.txt,
# resume.txt (clone=, base=, head= of the run) and mutants.out/.
# --resume <out-dir> (exchange D-154: a lost 3-hour run was redone from scratch): resumes an earlier run of this script
# in its own outcome directory. Refused unless <out-dir> holds changes.diff, list.txt, resume.txt and
# mutants.out/{caught,unviable}.txt ("is not an outcome directory of local-mutants"), and its resume.txt names this clone;
# refused "the base or HEAD changed since that run" unless the fresh diff is byte-identical to changes.diff (cmp), base
# and HEAD equal resume.txt's, and the fresh --list output equals list.txt line for line (--list runs before that last
# check; nothing is mutated). The run then uses `-o <out-dir>` and `--iterate` (never on the --list call), which skips
# the mutants caught before. `cargo mutants --help` does not say whether an iterated run's outcome files keep the earlier
# caught and unviable mutants, so they are counted as the UNION (sort -u) of the earlier ones, copied aside first to
# <out-dir>/union/{caught,unviable}.prev (the earlier union too, after a resume of a resume), and the new run's; the
# union is kept in <out-dir>/union/{caught,unviable}.txt. missed and timeout are the new run's alone (--iterate tests
# them again). A mutant named under two outcomes is an exit 1. tested = listed, the run: line and the exit codes are as
# without --resume.
# MUTANTS_PG_DURABILITY (exchange D-156; every #[sqlx::test] creates a database and migrates it, about 6x faster with
# durability off): unset or empty, nothing happens; `off`: DATABASE_URL is taken from the environment, else read as data
# from <clone>/.env by bin/read-env (never sourced), checked and split into PGHOST, PGPORT, PGUSER, PGPASSWORD and
# PGDATABASE for psql (psql does not read DATABASE_URL, nor a URL in PGDATABASE), so the URL never reaches an argv or a
# log line; psql must be on PATH. Before the --list call, `psql -X -w -v ON_ERROR_STOP=1 -q` runs `ALTER SYSTEM SET
# fsync = off`, `... synchronous_commit = off`, `... full_page_writes = off` and `SELECT pg_reload_conf()` (its output
# to stderr); stderr says "local-mutants: durability off for this run (fsync, synchronous_commit, full_page_writes);
# restored at exit". From just before that call, every exit (EXIT, HUP 129, INT 130, QUIT 131, PIPE 141, TERM 143;
# those signals ignored during the restore) runs the same four statements with `on`; a failed restore prints
# "local-mutants: WARNING durability was not restored (psql rc=<n>): ..." on stderr and turns an exit 0 into 1 (a
# non-zero exit stays), and the build lock is released after it. Residual: SIGKILL (or the kernel's OOM killer on this
# shell) runs no trap, so durability stays off; run the ALTER SYSTEM ... = on statements and pg_reload_conf() by hand.
# Exit 0 iff missed + timeout = 0 and cargo mutants exited 0 (and durability, when turned off, was restored). Exit 1
# with the line: survivors (missed or timeout), or a failed durability restore. Exit 1 without it: an incomplete run
# (tested != listed), cargo mutants failing (--list, a red baseline, any exit other than 0/2/3, an exit 2/3 its outcome
# files contradict), missing outcome files, a mutant under two outcomes after --resume, mutants-run.txt unwritable.
# Exit 2, "local-mutants: refused — <reason>" (nothing run): usage; <base> not 40 lowercase hex; an empty --tests list
# or a name not [A-Za-z0-9_]+; MUTANTS_MEMORY_MAX not ^[0-9]+[KMG]$, or not 1 to 9 digits without a leading zero (the
# byte count stays exact); MUTANTS_NO_SCCACHE neither 1 nor unset; no sccache without that opt-out;
# MUTANTS_PG_DURABILITY neither off nor unset; with off: no DATABASE_URL, a URL this script cannot split, no psql, or
# psql failing to turn durability off; systemd-run
# missing or unable to create the scope or read its memory.max; "memory cap not enforced" (the scope's memory.max is
# not the cap in bytes); not a disposable clone; <base> not a commit; no file in scope; a changed file name the run:
# line cannot carry; --resume of a directory that is not this clone's outcome directory, or whose diff, base, HEAD or
# listing changed. Exit 2 with build-lock's own message instead ("build-lock: BUILD_LOCK_WAIT must be a whole number of
# seconds", "build-lock: BUILD_LOCK_STALE must be a whole number of seconds"): a bad BUILD_LOCK_WAIT or BUILD_LOCK_STALE.
# Exit 3: the build lock is held elsewhere after BUILD_LOCK_WAIT (a dead holder's lock older than BUILD_LOCK_STALE is
# taken first, bin/build-lock.sh).
set -u
PATH="$HOME/.cargo/bin:$PATH"; export PATH
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd -P) || { echo "local-mutants: cannot locate its own directory" >&2; exit 2; }
usage() { echo "local-mutants: usage: local-mutants <clone> <base> <crate> [--tests <name>[,<name>...]] [--resume <out-dir>]" >&2; exit 2; }
refuse() { echo "local-mutants: refused — $1" >&2; exit 2; }
fail() { echo "local-mutants: $1" >&2; exit 1; }
[ $# -ge 3 ] || usage
clone_arg=$1; base=$2; crate=$3; shift 3
tests_set=0; tests=; resume_set=0; resume=
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage
  case "$1" in
    --tests) [ $tests_set -eq 0 ] || usage; tests_set=1; tests=$2;;
    --resume) [ $resume_set -eq 0 ] || usage; resume_set=1; resume=$2;;
    *) usage;;
  esac
  shift 2
done
case "$crate" in ''|-*|*[!A-Za-z0-9_-]*) usage;; esac
case "$base" in ''|-*) usage;; esac
case "$base" in *[!0-9a-f]*) refuse "<base> must be a full 40-character lowercase hex SHA, got '$base'";; esac
[ ${#base} -eq 40 ] || refuse "<base> must be a full 40-character lowercase hex SHA, got '$base'"
# The names are [A-Za-z0-9_]+ once checked, so $testargs splits into exactly its words.
testargs=
if [ $tests_set -eq 1 ]; then
  [ -n "$tests" ] || refuse "--tests needs at least one test binary name"
  case "$tests" in ,*|*,|*,,*) refuse "--tests '$tests' has a name that is not [A-Za-z0-9_]+";; esac
  rest=$tests
  while [ -n "$rest" ]; do
    name=${rest%%,*}
    case "$name" in ''|*[!A-Za-z0-9_]*) refuse "--tests '$tests' has a name that is not [A-Za-z0-9_]+";; esac
    testargs="$testargs --test $name"
    case "$rest" in *,*) rest=${rest#*,};; *) rest=;; esac
  done
fi
mm=${MUTANTS_MEMORY_MAX:-3G}
mmn=${mm%[KMG]}
case "$mmn" in ''|*[!0-9]*) mmn=;; esac
[ -n "$mmn" ] && [ "$mmn" != "$mm" ] || refuse "MUTANTS_MEMORY_MAX must be digits followed by K, M or G (like 3G), got '$mm'"
# The cap in bytes, for the read-back below: no leading zero (shell arithmetic reads it as octal) and at most 9 digits
# (999999999G stays below 2^63).
case "$mmn" in 0*|??????????*) refuse "MUTANTS_MEMORY_MAX must be 1 to 9 digits without a leading zero, then K, M or G, got '$mm'";; esac
case "$mm" in *K) mmb=$((mmn * 1024));; *M) mmb=$((mmn * 1048576));; *) mmb=$((mmn * 1073741824));; esac
case "${MUTANTS_NO_SCCACHE-}" in
  '') sc=$(command -v sccache 2>/dev/null) && [ -n "$sc" ] \
        || refuse "sccache is not in \$HOME/.cargo/bin or on PATH; every mutation run is cached (MUTANTS_NO_SCCACHE=1 opts out)"
      RUSTC_WRAPPER=sccache; cache="sccache $sc";;
  1) RUSTC_WRAPPER=; cache="none (MUTANTS_NO_SCCACHE=1)";;
  *) refuse "MUTANTS_NO_SCCACHE must be 1 or unset, got '$MUTANTS_NO_SCCACHE'";;
esac
export RUSTC_WRAPPER
case "${MUTANTS_PG_DURABILITY-}" in
  '') dur=;;
  off) dur=off;;
  *) refuse "MUTANTS_PG_DURABILITY must be off or unset, got '$MUTANTS_PG_DURABILITY'";;
esac
command -v systemd-run >/dev/null 2>&1 || refuse "systemd-run is not on PATH; cargo mutants never runs without the memory cap"
notclone() { refuse "$1 is not a disposable clone (its own .git directory, no remote, clean tree)"; }
[ -d "$clone_arg" ] || notclone "$clone_arg"
clone=$(cd "$clone_arg" && pwd -P) || notclone "$clone_arg"
[ -d "$clone/.git" ] && [ ! -L "$clone/.git" ] || notclone "$clone"
top=$(git -C "$clone" rev-parse --show-toplevel 2>/dev/null) && [ "$(cd "$top" && pwd -P)" = "$clone" ] || notclone "$clone"
gd=$(git -C "$clone" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && [ "$(cd "$gd" && pwd -P)" = "$clone/.git" ] || notclone "$clone"
remotes=$(git -C "$clone" remote) || notclone "$clone"
[ -z "$remotes" ] || notclone "$clone"
wts=$(git -C "$clone" worktree list --porcelain) || notclone "$clone"
[ "$(printf '%s\n' "$wts" | grep -c '^worktree ')" -eq 1 ] || notclone "$clone"
st=$(git -C "$clone" status --porcelain --untracked-files=all --ignore-submodules=none) || notclone "$clone"
[ -z "$st" ] || notclone "$clone"
# --resume: the directory's shape and its clone, before anything runs.
if [ $resume_set -eq 1 ]; then
  notout() { refuse "--resume $resume is not an outcome directory of local-mutants"; }
  [ -n "$resume" ] && [ -d "$resume" ] || notout
  rdir=$(cd "$resume" && pwd -P) || notout
  for f in changes.diff list.txt resume.txt mutants.out/caught.txt mutants.out/unviable.txt; do [ -f "$rdir/$f" ] || notout; done
  rclone=$(sed -n 's/^clone=//p' "$rdir/resume.txt" | head -n 1); rbase=$(sed -n 's/^base=//p' "$rdir/resume.txt" | head -n 1)
  rhead=$(sed -n 's/^head=//p' "$rdir/resume.txt" | head -n 1)
  [ -n "$rclone" ] && [ -n "$rbase" ] && [ -n "$rhead" ] || notout
  [ "$rclone" = "$clone" ] || refuse "--resume $resume is an outcome directory of another clone ($rclone)"
fi
# MUTANTS_PG_DURABILITY=off: the URL resolved, checked and split now (nothing runs before every refusal is behind us).
# pg_split <url>: postgres[ql]://[user[:password]@]host[:port][/database] of URL-safe characters only, else 1.
pg_split() {
  _r=$1; pg_user=; pg_pass=; pg_host=; pg_port=; pg_db=
  case "$_r" in postgres://*) _r=${_r#postgres://};; postgresql://*) _r=${_r#postgresql://};; *) return 1;; esac
  case "$_r" in *[!A-Za-z0-9._~:@/-]*|*@*@*) return 1;; esac
  case "$_r" in *@*) _a=${_r%%@*}; _r=${_r#*@}
    case "$_a" in *:*) pg_user=${_a%%:*}; pg_pass=${_a#*:};; *) pg_user=$_a;; esac;; esac
  case "$_r" in */*) pg_db=${_r#*/}; _r=${_r%%/*};; esac
  case "$pg_db" in */*) return 1;; esac
  case "$_r" in *:*) pg_port=${_r#*:}; _r=${_r%%:*}; case "$pg_port" in ''|*[!0-9]*) return 1;; esac;; esac
  pg_host=$_r; [ -n "$pg_host" ] || return 1
}
if [ "$dur" = off ]; then
  if [ -n "${DATABASE_URL:-}" ]; then dburl=$DATABASE_URL
  elif dburl=$(sh "$here/read-env" DATABASE_URL "$clone/.env" 2>/dev/null) && [ -n "$dburl" ]; then :
  else refuse "MUTANTS_PG_DURABILITY=off needs DATABASE_URL in the environment or the clone's .env"; fi
  pg_split "$dburl" || refuse "DATABASE_URL is not a postgres:// URL this script can split (postgres[ql]://[user[:password]@]host[:port][/database] of A-Z a-z 0-9 . _ ~ -; no percent-encoding, query or second host); turn durability off by hand"
  command -v psql >/dev/null 2>&1 || refuse "MUTANTS_PG_DURABILITY=off needs psql on PATH"
fi
# pg_run off|on: the four statements; psql gets the connection from libpq variables, never from its argv.
pg_run() {
  ( [ -z "$pg_host" ] || { PGHOST=$pg_host; export PGHOST; }
    [ -z "$pg_port" ] || { PGPORT=$pg_port; export PGPORT; }
    [ -z "$pg_user" ] || { PGUSER=$pg_user; export PGUSER; }
    [ -z "$pg_pass" ] || { PGPASSWORD=$pg_pass; export PGPASSWORD; }
    [ -z "$pg_db" ] || { PGDATABASE=$pg_db; export PGDATABASE; }
    DATABASE_URL=$dburl; export DATABASE_URL
    exec psql -X -w -v ON_ERROR_STOP=1 -q -c "ALTER SYSTEM SET fsync = $1" -c "ALTER SYSTEM SET synchronous_commit = $1" \
      -c "ALTER SYSTEM SET full_page_writes = $1" -c 'SELECT pg_reload_conf()' ) >&2
}
# The EXIT trap once durability may be off: restore it (signals ignored meanwhile), then release the build lock.
on_exit() {
  ec=$?; trap - EXIT; trap '' HUP INT TERM QUIT PIPE
  if [ "${dur_live:-0}" = 1 ]; then
    dur_live=0; pg_run on; drc=$?
    if [ $drc -ne 0 ]; then
      echo "local-mutants: WARNING durability was not restored (psql rc=$drc): run the ALTER SYSTEM SET fsync, synchronous_commit, full_page_writes = on statements and SELECT pg_reload_conf() by hand" >&2
      [ $ec -ne 0 ] || ec=1
    fi
  fi
  build_lock_release
  exit $ec
}
git -C "$clone" rev-parse -q --verify "$base^{commit}" >/dev/null 2>&1 || refuse "$base is not a commit in $clone"
echo "base: $base" >&2
sha=$(git -C "$clone" rev-parse HEAD) || fail "git rev-parse HEAD failed in $clone"
if [ $resume_set -eq 1 ]; then
  out=$rdir
  git -C "$clone" diff --no-color --no-ext-diff "$base" HEAD -- "$crate/src" > "$out/changes.diff.resume" || fail "git diff $base HEAD failed in $clone"
  cmp -s "$out/changes.diff.resume" "$out/changes.diff" && [ "$rbase" = "$base" ] && [ "$rhead" = "$sha" ] \
    || refuse "the base or HEAD changed since that run; start a new one"
  iterate=--iterate
else
  out=$(mktemp -d "${TMPDIR:-/tmp}/local-mutants.XXXXXX") || fail "mktemp failed"
  printf 'clone=%s\nbase=%s\nhead=%s\n' "$clone" "$base" "$sha" > "$out/resume.txt" || fail "could not write $out/resume.txt"
  git -C "$clone" diff --no-color --no-ext-diff "$base" HEAD -- "$crate/src" > "$out/changes.diff" || fail "git diff $base HEAD failed in $clone"
  iterate=
fi
names=$(git -C "$clone" diff --no-color --name-only --diff-filter=d "$base" HEAD -- "$crate/src") || fail "git diff --name-only failed in $clone"
# git quotes an unusual name ("..."), so a quoted .rs name is caught here too, never silently dropped; with only these
# characters a name holds no space, so the space-separated list splits back into exactly its names.
rs=$(printf '%s\n' "$names" | grep -E '\.rs"?$')
odd=$(printf '%s\n' "$rs" | grep -vE '^[A-Za-z0-9_./-]+$' | head -n 1)
[ -z "$odd" ] || refuse "the changed file '$odd' has a name the run: line cannot carry (only A-Z a-z 0-9 _ . / -)"
files=$(printf '%s\n' "$rs" | grep -E "^$crate/src/.+\.rs\$" | sort | paste -s -d ' ' -)
[ -n "$files" ] || refuse "no $crate/src/**/*.rs file changed in $base..HEAD; nothing to mutate"
scope() { systemd-run --user --scope --quiet -p "MemoryMax=$mm" -p MemorySwapMax=0 -p OOMPolicy=stop -- "$@"; }
# The probe reads the cap back from the scope's own cgroup (the single quotes keep $(...) for the scope's shell).
if ! scope sh -c 'cat /sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup)/memory.max' > "$out/scope-probe.out" 2> "$out/scope-probe.err"; then
  why=$(grep . "$out/scope-probe.err" | head -n 1)
  refuse "systemd-run could not create a scope with MemoryMax=$mm, MemorySwapMax=0 and OOMPolicy=stop or read its memory.max (${why:-no message}); cargo mutants never runs uncapped"
fi
got=$(cat "$out/scope-probe.out") || refuse "could not read $out/scope-probe.out"
[ "$got" = "$mmb" ] || refuse "memory cap not enforced: the scope's memory.max reads '$got', not $mmb (MemoryMax=$mm); cargo mutants never runs uncapped"
cd "$clone" || notclone "$clone"
BUILD_LOCK_WHO=local-mutants; . "$here/build-lock.sh"
build_lock_acquire; rc=$?
if [ $rc -eq 3 ]; then build_lock_refusal; exit 3; fi
[ $rc -eq 0 ] || exit $rc
build_lock_env || exit 1
echo "local-mutants: compiler cache: $cache; MemoryMax=$mm; outcomes in $out" >&2
if [ "$dur" = off ]; then
  dur_live=1
  trap on_exit EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 131' QUIT; trap 'exit 141' PIPE
  pg_run off; prc=$?
  [ $prc -eq 0 ] || refuse "durability could not be turned off (psql rc=$prc); nothing run"
  echo "local-mutants: durability off for this run (fsync, synchronous_commit, full_page_writes); restored at exit" >&2
fi
if [ $resume_set -eq 1 ]; then lout="$out/list.txt.resume"; else lout="$out/list.txt"; fi
scope cargo mutants --list --no-config --in-diff "$out/changes.diff" -p "$crate" > "$lout" 2> "$out/list.err"; lrc=$?
[ $lrc -eq 0 ] || fail "cargo mutants --list failed (rc=$lrc); see $out/list.err"
if [ $resume_set -eq 1 ]; then cmp -s "$lout" "$out/list.txt" || refuse "the base or HEAD changed since that run; start a new one"; fi
n_of() { n=$(grep -c . "$1"); case "$n" in ''|*[!0-9]*) fail "could not read $1";; esac; echo "$n"; }
listed=$(n_of "$out/list.txt") || exit 1
c=0; m=0; u=0; k=0; mrc=0; o="$out/mutants.out"; ud="$out/union"
if [ "$listed" -gt 0 ]; then
  if [ $resume_set -eq 1 ]; then
    # The earlier caught and unviable, copied aside before cargo mutants rewrites mutants.out.
    mkdir -p "$ud" || fail "could not create $ud"
    # Every earlier record that exists: the last union, the last copy aside (a resumed run that was itself interrupted
    # never wrote a union) and mutants.out; built in a temp file, then moved into place.
    for kind in caught unviable; do
      set --
      for f in "$ud/$kind.txt" "$ud/$kind.prev" "$o/$kind.txt"; do [ ! -f "$f" ] || set -- "$@" "$f"; done
      { sort -u "$@" > "$ud/$kind.prev.tmp" && mv "$ud/$kind.prev.tmp" "$ud/$kind.prev"; } \
        || fail "could not copy the earlier $kind mutants aside to $ud/$kind.prev"
    done
  fi
  scope cargo mutants --no-config --in-diff "$out/changes.diff" -p "$crate" --test-tool nextest --jobs 1 \
    --minimum-test-timeout 60 --timeout-multiplier 2 -o "$out" $iterate \
    -- -E 'not test(=random_sessions_match_model)' $testargs > "$out/mutants.log" 2>&1; mrc=$?
  case $mrc in
    0|2|3) ;;
    4) fail "cargo mutants failed (rc=4: its baseline, the unmutated tree, is red); log: $out/mutants.log";;
    *) fail "cargo mutants failed (rc=$mrc); log: $out/mutants.log";;
  esac
  for kind in caught missed timeout unviable; do [ -f "$o/$kind.txt" ] || fail "no outcome files in $o (cargo mutants did not finish)"; done
  c=$(n_of "$o/caught.txt") || exit 1; m=$(n_of "$o/missed.txt") || exit 1
  u=$(n_of "$o/unviable.txt") || exit 1; k=$(n_of "$o/timeout.txt") || exit 1
  if [ $resume_set -eq 1 ]; then
    for kind in caught unviable; do
      sort -u "$ud/$kind.prev" "$o/$kind.txt" > "$ud/$kind.txt" || fail "could not unite the $kind mutants in $ud/$kind.txt"
    done
    c=$(n_of "$ud/caught.txt") || exit 1; u=$(n_of "$ud/unviable.txt") || exit 1
    cat "$ud/caught.txt" "$ud/unviable.txt" "$o/missed.txt" "$o/timeout.txt" > "$ud/all.txt" || fail "could not read the outcome files"
    sort -u "$ud/all.txt" > "$ud/all.distinct" || fail "could not read the outcome files"
    na=$(n_of "$ud/all.txt") || exit 1; nd=$(n_of "$ud/all.distinct") || exit 1
    [ "$na" -eq "$nd" ] || fail "a mutant is named under two outcomes after --resume (caught or unviable before, another outcome now); see $ud"
  fi
fi
t=$((c + m + u + k))
[ "$t" -eq "$listed" ] || fail "incomplete run — tested $t (missed $m, caught $c, unviable $u, timeout $k) of $listed listed mutants"
if [ $mrc -ne 0 ] && [ $((m + k)) -eq 0 ]; then fail "cargo mutants exited $mrc but its outcome files list no missed or timed-out mutant"; fi
line="run: $sha files: $files tested: $t missed: $m caught: $c unviable: $u timeout: $k"
( printf '%s\n' "$line" > "$clone/mutants-run.txt" ) 2>/dev/null || fail "could not write $clone/mutants-run.txt"
printf '%s\n' "$line"
if [ $((m + k)) -ne 0 ]; then echo "local-mutants: survivors — see $o/missed.txt and $o/timeout.txt" >&2; exit 1; fi
exit 0
