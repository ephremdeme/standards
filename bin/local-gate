#!/bin/sh
# Usage: standards/bin/local-gate <repo-dir> <mN> <log>        (the integrator, on the dev machine; exchange D-109)
# The local evidence gate that replaces GitHub-hosted CI. From the top of <repo-dir> it runs standards/bin/check under
# the machine build lock (bin/with-build-lock), then the full chain `bash scripts/verify/<mN>.sh` (no --section; the
# instrument takes the verify and build locks itself), with VERIFY_FAIL_TAIL=${VERIFY_FAIL_TAIL:-400} exported, both
# outputs appended to the fresh file <log>. The log starts with `free -m` (memory, not disk, is the machine's limit:
# the exchange OOM history) and always ends, green or red, with "gate-head: <full SHA of HEAD at the start>", one
# "gate-tree: clean" or "gate-tree: dirty (<first path>)" and one "gate-verdict: green <mN>" or "gate-verdict: red —
# <first reason>", so a red log is evidence too. The verdict is decided before these lines are written, from the log
# and what only the gate sees (the exit codes, HEAD, the tree): chained instruments print green verify lines of their
# own before the outer run starts, and the outer run can die (a lock refusal, a kill) or exit non-zero after a green
# line, so only the verdict says the gate passed. The tree is re-read at the end, tracked files only (`git status
# --porcelain --untracked-files=no --ignore-submodules=none`; instruments may leave untracked artifacts): clean means
# that status is empty and HEAD did not move; otherwise "dirty (<first path>)", "dirty (HEAD moved)" or "dirty (git
# status failed)". If HEAD moved during the run, the SHA at the end gets a second gate-head line, so the log matches no
# single head. `merge-pr --local-log` reads these lines; the evidence is integrator-attested, bound to the SHA by
# gate-head.
# Refused (exit 2, "local-gate: refused — <reason>", nothing run and no log written) unless: <mN> matches
# ^[a-z][a-z0-9_]*$ (a lowercase letter, then lowercase letters, digits or _: the game's m2_2 too); VERIFY_FAIL_TAIL is
# a positive integer; LOCAL_GATE_INSTRUMENT_OVERRIDE is 1 or unset; <repo-dir> is the top level of a git checkout
# with a commit and `git status` reads it; its tree is clean apart from an untracked TASK.md at the top (the first
# other status line is named); standards/bin/check and scripts/verify/<mN>.sh exist; no scripts/verify/<id>.sh is
# newer than <mN> (below); <log> does not exist (not even as a dangling link) and can be created.
# The newest instrument, so a lane PR is always backed by the current chain: an id's version is its digit runs read as
# numbers, left to right (letters and _ only separate them; a shorter version is the lower: m2 < m2_1), so e10 > e9 >
# e2 > e1 > m0 and m2_2 > m2_1 > m1_1; <mN> is refused when an id (a .sh name matching the id rule) has a greater
# version, an equal version is not newer. LOCAL_GATE_INSTRUMENT_OVERRIDE=1 skips this rule and writes
# "gate-instrument: <mN> (override)" into the log right after free -m.
# Exit 0, "local-gate: OK <mN> <sha> <log>", only if HEAD did not move, the tree is clean at the end, check printed
# "check: OK" and no "check: FAILED" and exited 0, the log has no "[FAIL]" line and no verify line with a failed count
# above 0, it has a line "verify:<mN> — N ok, 0 failed" with N >= 1, and the instrument exited 0. Otherwise exit 1,
# "local-gate: RED <mN> <sha> — <first reason> (log <log>)", the same reason as the verdict line's, also when the log
# cannot be read, and "the log could not be written" when the trailing lines fail (merge-pr refuses a log without
# exactly one green verdict).
set -u
PATH="$HOME/.cargo/bin:$PATH"; export PATH
LC_ALL=C; export LC_ALL
here=$(cd "$(dirname "$0")" && pwd -P) || { echo "local-gate: cannot locate its own directory" >&2; exit 2; }
refuse() { echo "local-gate: refused — $1" >&2; exit 2; }
[ $# -eq 3 ] || { echo "local-gate: usage: local-gate <repo-dir> <mN> <log>" >&2; exit 2; }
dir=$1; ms=$2; log=$3
case "$ms" in ''|[!a-z]*|*[!a-z0-9_]*) refuse "'$ms' is not a milestone id (a lowercase letter, then lowercase letters, digits or _)";; esac
VERIFY_FAIL_TAIL=${VERIFY_FAIL_TAIL:-400}
case "$VERIFY_FAIL_TAIL" in 0*|*[!0-9]*) refuse "VERIFY_FAIL_TAIL must be a positive integer, got '$VERIFY_FAIL_TAIL'";; esac
export VERIFY_FAIL_TAIL
override=${LOCAL_GATE_INSTRUMENT_OVERRIDE-}
case "$override" in ''|1) ;; *) refuse "LOCAL_GATE_INSTRUMENT_OVERRIDE must be 1 or unset, got '$override'";; esac
nottop() { refuse "$dir is not the top level of a git checkout with a commit"; }
[ -d "$dir" ] || nottop
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] || nottop
[ "$(cd "$top" && pwd -P)" = "$(cd "$dir" && pwd -P)" ] || nottop
head=$(git -C "$dir" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || nottop
case "$head" in ''|*[!0-9a-f]*) nottop;; esac
st=$(git -C "$dir" status --porcelain --untracked-files=all --ignore-submodules=none 2>/dev/null) || refuse "git status failed in $dir"
dirt=$(printf '%s\n' "$st" | grep -vx '?? TASK.md' | grep . | head -n 1)
[ -z "$dirt" ] || refuse "the tree of $dir is not clean (first: ${dirt#???})"
[ -f "$dir/standards/bin/check" ] || refuse "$dir has no standards/bin/check"
[ -f "$dir/scripts/verify/$ms.sh" ] || refuse "$dir has no scripts/verify/$ms.sh"
# The newest instrument: awk keys each id by its digit runs (leading zeros dropped, each run as its length in 3 digits,
# then the digits, then "."), so a byte comparison of keys orders the versions; it prints <mN> when no key is greater,
# else the first id with the greatest key. An empty answer (awk or the listing failed) refuses.
if [ "$override" != 1 ]; then
  newer=$(for f in "$dir"/scripts/verify/*.sh; do
      b=${f##*/}; b=${b%.sh}
      case "$b" in ''|[!a-z]*|*[!a-z0-9_]*) continue;; esac
      if [ -f "$f" ]; then printf '%s\n' "$b"; fi
    done | awk -v ms="$ms" '
      function key(s,  k, d) { k = ""
        while (match(s, /[0-9]+/)) { d = substr(s, RSTART, RLENGTH); sub(/^0+/, "", d); k = k sprintf("%03d", length(d)) d "."; s = substr(s, RSTART + RLENGTH) }
        return k }
      { k = key($0); if (NR == 1 || k > top) { top = k; id = $0 } }
      END { if (NR > 0) print ((key(ms) "") == (top "") ? ms : id) }')
  [ -n "$newer" ] || refuse "cannot order the instruments in $dir/scripts/verify"
  [ "$newer" = "$ms" ] || refuse "$ms is not the newest instrument of $dir (scripts/verify/$newer.sh is newer); LOCAL_GATE_INSTRUMENT_OVERRIDE=1 runs an older one"
fi
if [ -e "$log" ] || [ -L "$log" ]; then refuse "$log exists; the gate writes a fresh log only"; fi
# noclobber: the log is created here or not at all, never truncated.
( set -C; : > "$log" ) 2>/dev/null || refuse "cannot create the log $log"
red() { echo "local-gate: RED $ms $head — $1 (log $log)" >&2; exit 1; }
free -m >> "$log" 2>&1 || echo "local-gate: free -m failed (exit $?)" >> "$log"
if [ "$override" = 1 ]; then printf 'gate-instrument: %s (override)\n' "$ms" >> "$log" || red "the log could not be written"; fi
( cd "$dir" && sh "$here/with-build-lock" sh standards/bin/check ) < /dev/null >> "$log" 2>&1; crc=$?
( cd "$dir" && bash "scripts/verify/$ms.sh" ) < /dev/null >> "$log" 2>&1; irc=$?
end=$(git -C "$dir" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || end=unreadable
# The tree at the end: tracked files only, and HEAD where it started; a failing git status is dirt (fail closed).
tree=clean; tree_why=
if est=$(git -C "$dir" status --porcelain --untracked-files=no --ignore-submodules=none 2>/dev/null); then
  first=$(printf '%s\n' "$est" | grep . | head -n 1)
  if [ -n "$first" ]; then tree="dirty (${first#???})"; tree_why="the tree is not clean at the end (first: ${first#???})"
  elif [ "$end" != "$head" ]; then tree="dirty (HEAD moved)"
  fi
else tree="dirty (git status failed)"; tree_why="git status failed at the end"
fi
# The verdict, before the trailing lines: the log read as merge-pr --local-log reads it, plus what only the gate sees.
cnt() { grep -c -E -- "$1" "$log"; [ $? -le 1 ]; }
why=
n_cfail=$(cnt '^check: FAILED') && n_cok=$(cnt '^check: OK$') && n_fail=$(cnt '^\[FAIL\]') \
  && n_vbad=$(cnt '^verify:.* [1-9][0-9]* failed$') && n_vok=$(cnt "^verify:$ms — [0-9]*[1-9][0-9]* ok, 0 failed\$") \
  || why="the log could not be read"
if [ -n "$why" ]; then :
elif [ "$end" != "$head" ]; then why="HEAD moved from $head to $end during the run"
elif [ -n "$tree_why" ]; then why=$tree_why
elif [ "$n_cfail" -ne 0 ]; then why="check printed check: FAILED"
elif [ "$n_cok" -lt 1 ]; then why="check printed no check: OK line"
elif [ $crc -ne 0 ]; then why="check exited $crc"
elif [ "$n_fail" -ne 0 ]; then why="the log has $n_fail [FAIL] line(s)"
elif [ "$n_vbad" -ne 0 ]; then why="a verify line reports failures: $(grep -E '^verify:.* [1-9][0-9]* failed$' "$log" | head -n 1)"
elif [ "$n_vok" -lt 1 ]; then why="no verify:$ms — N ok, 0 failed line with N >= 1"
elif [ $irc -ne 0 ]; then why="scripts/verify/$ms.sh exited $irc"
fi
if [ -z "$why" ]; then verdict="green $ms"; else verdict="red — $why"; fi
{ printf 'gate-head: %s\n' "$head"; if [ "$end" != "$head" ]; then printf 'gate-head: %s\n' "$end"; fi
  printf 'gate-tree: %s\n' "$tree"; printf 'gate-verdict: %s\n' "$verdict"; } >> "$log" \
  || red "the log could not be written"
[ -z "$why" ] || red "$why"
echo "local-gate: OK $ms $head $log"
