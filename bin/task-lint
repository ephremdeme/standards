#!/bin/sh
# Usage: task-lint <absolute worktree>
# Pre-dispatch lint of a lane (C7, C5 disk floor, NOTES-19 defect 4; docs/07 §4): run before EVERY dispatch, DeepSeek
# (dispatch-deepseek runs its own copy) or `architect` (the coordinator runs it). Every rule is evaluated — the run never
# stops at the first failure — and each failure prints one line `task-lint: FAIL <rule>: <detail>`; then
# `task-lint: OK (<wt>)` exit 0, or `task-lint: FAILED (<n> rule(s))` exit 1. Usage errors exit 2.
# Rules: header (lines 1-3 Branch:/Base:/Risk: LOW|HIGH, one Risk: line in the TASK), branch (<model>/<slug>, equal to
# the worktree's), base (full sha, a commit here, an ancestor of HEAD), owned (bin/owned-paths accepts §3's block),
# sections (## 1. to ## 7.), clean (nothing uncommitted but an untracked TASK.md), submodule (every submodule at the
# commit HEAD records), disk (15 GB free on the worktree's filesystem; no override exists). Every git/df failure is a
# FAIL, never a pass (capture first, then filter).
set -u
here=$(cd "$(dirname "$0")" && pwd -P) || { echo "task-lint: cannot locate its own directory" >&2; exit 2; }
usage() { echo "task-lint: usage: task-lint <absolute worktree>" >&2; exit 2; }
[ $# -eq 1 ] || usage
wt=$1
case "$wt" in /*) ;; *) usage;; esac
[ "$wt" = / ] || wt=${wt%/}
task="$wt/TASK.md"
[ -f "$task" ] && [ -r "$task" ] || { echo "task-lint: no TASK.md in $wt" >&2; exit 2; }
nfail=0
fail() { echo "task-lint: FAIL $1: $2"; }
count() { nfail=$((nfail + 1)); }

# header
l1=$(sed -n 1p "$task"); l2=$(sed -n 2p "$task"); l3=$(sed -n 3p "$task")
nrisk=$(grep -c '^Risk: ' "$task" || true)
case "$l1" in "Branch: "?*) h1=1;; *) h1=0;; esac
case "$l2" in "Base: "?*) h2=1;; *) h2=0;; esac
case "$l3" in "Risk: LOW"|"Risk: HIGH") h3=1;; *) h3=0;; esac
if [ $h1 -eq 0 ] || [ $h2 -eq 0 ] || [ $h3 -eq 0 ] || [ "$nrisk" != 1 ]; then
  fail header "lines 1-3 must be Branch:, Base:, Risk: LOW|HIGH and the TASK must hold exactly one Risk: line"; count; fi

# branch
b=${l1#Branch: }; [ "$h1" -eq 1 ] || b=""
if ! printf '%s\n' "$b" | grep -Eqx '[A-Za-z0-9]+/[A-Za-z0-9][A-Za-z0-9_.-]*'; then
  fail branch "'$b' is not <model>/<slug> (^[A-Za-z0-9]+/[A-Za-z0-9][A-Za-z0-9_.-]*\$)"; count
else
  cur=$(git -C "$wt" branch --show-current 2>/dev/null) || cur="(git branch failed)"
  [ -n "$cur" ] || cur="(no branch: detached HEAD)"
  if [ "$cur" != "$b" ]; then fail branch "TASK says $b, the worktree is on $cur"; count; fi
fi

# base
v=${l2#Base: }; [ "$h2" -eq 1 ] || v=""
if ! printf '%s\n' "$v" | grep -Eqx '[0-9a-f]{40}'; then
  fail base "'$v' is not a full 40-character commit sha"; count
elif ! git -C "$wt" cat-file -e "$v^{commit}" 2>/dev/null; then
  fail base "$v is not a commit in this repository"; count
else
  head=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || head="(git rev-parse HEAD failed)"
  if ! git -C "$wt" merge-base --is-ancestor "$v" HEAD 2>/dev/null; then fail base "$v is not an ancestor of HEAD $head"; count; fi
fi

# owned (the lint's own copy of owned-paths, never the lane's)
msg=$(sh "$here/owned-paths" "$task" 2>&1 >/dev/null); orc=$?
if [ $orc -ne 0 ]; then
  [ -n "$msg" ] || msg="owned-paths failed (exit $orc)"
  fail owned "$(printf '%s\n' "$msg" | head -n 1 | sed 's/^owned-paths: //')"; count
fi

# sections
sfail=0
for n in 1 2 3 4 5 6 7; do
  if ! grep -Eq "^## $n\\.( |\$)" "$task"; then fail sections "missing heading ## $n."; sfail=1; fi
done
[ $sfail -eq 0 ] || count

# clean
if st=$(git -C "$wt" status --porcelain --untracked-files=all --ignore-submodules=none 2>/dev/null); then
  dirty=$(printf '%s\n' "$st" | grep -vx -e '?? TASK.md' -e '' || true)
  if [ -n "$dirty" ]; then
    first=$(printf '%s\n' "$dirty" | head -n 1); fail clean "uncommitted changes besides TASK.md: ${first#???}"; count; fi
else fail clean "uncommitted changes besides TASK.md: (git status failed)"; count; fi

# submodule (NOTES-19 defect 4)
if [ -f "$wt/.gitmodules" ]; then
  primary="<primary checkout>"
  if common=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && [ -n "$common" ]; then
    primary=$(cd "$common/.." 2>/dev/null && pwd -P) || primary="<primary checkout>"; fi
  if ss=$(git -C "$wt" submodule status 2>/dev/null); then
    bad=$(printf '%s\n' "$ss" | grep -E '^[-+U]' | head -n 1)
    if [ -n "$bad" ]; then
      name=$(printf '%s\n' "$bad" | awk '{print $2}')
      st_line=$(printf '%s\n' "$bad" | sed -e 's/[[:space:]]*$//')
      fail submodule "$name is not at the commit HEAD records ($st_line) — run: git -C $wt -c protocol.file.allow=always -c submodule.$name.url=$primary/$name submodule update -q --init"; count
    fi
  else fail submodule "git submodule status failed in $wt"; count; fi
fi

# disk (C5: dispatch refuses below 15 GB free)
floor=$((15 * 1024 * 1024))
if dfo=$(df -Pk "$wt" 2>/dev/null); then
  avail=$(printf '%s\n' "$dfo" | awk 'NR == 2 { print $4 }')
  case "$avail" in ''|*[!0-9]*) fail disk "could not read free space (df -Pk $wt failed)"; count;;
    *) if [ "$avail" -lt "$floor" ]; then
         gb=$(awk -v k="$avail" 'BEGIN { printf "%.1f", k / 1048576 }')
         fail disk "$gb GB free on the filesystem of $wt, below the 15 GB floor — prune merged lanes (standards/bin/prune-lane)"; count
       fi;;
  esac
else fail disk "could not read free space (df -Pk $wt failed)"; count; fi

if [ $nfail -eq 0 ]; then echo "task-lint: OK ($wt)"; exit 0; fi
echo "task-lint: FAILED ($nfail rule(s))"; exit 1
